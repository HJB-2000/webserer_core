#!/bin/bash

# 1. Increase resource limits for 5000 connections
ulimit -n 10000

# 2. Define the command
COMMAND="../siege/usr/bin/siege -c 100 -t 10M http://localhost:8080/login.html"

echo "Preparing 10 instances..."

for i in {1..100}
do
    # Launch in background, but make them wait for a signal (USR1)
    (
        # 'trap' waits for the SIGUSR1 signal
        trap 'echo "Instance $i starting..."; exec $COMMAND' USR1
        # Sleep indefinitely until the signal arrives
        while true; do sleep 1; done
    ) &
    PIDS="$PIDS $!"
done

# Give the OS a moment to finish forking all processes
sleep 2 

echo "READY... SET... GO!"

# 3. Send the signal to ALL background processes simultaneously
kill -USR1 $PIDS

# Wait for all to finish
wait
