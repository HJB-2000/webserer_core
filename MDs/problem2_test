#!/bin/bash  
  
echo "=== Testing Location-Specific client_max_body_size ==="  
echo "Server-level limit: 10M"  
echo "CGI location limit: 1G"  
echo "CGI output size: 11MB"  
echo ""  
  
# Start server in background  
./webserv fahd.conf &  
SERVER_PID=$!  
sleep 2  
  
echo "Sending request to CGI script..."  
curl -v http://127.0.0.1:8080/cgi-bin/big_body_test.py 2>&1 | tee test_output.log  
  
# Check if server crashed  
if ! kill -0 $SERVER_PID 2>/dev/null; then  
    echo ""  
    echo "❌ FAILED: Server crashed (BUG EXISTS)"  
    echo "Expected: Server should handle 11MB output (11MB < 1G location limit)"  
    echo "Actual: Server crashed because CgiJob used 10M server-level limit"  
    exit 1  
fi  
  
# Check response  
if grep -q "200 OK" test_output.log; then  
    echo ""  
    echo "✅ PASSED: Server returned 200 OK"  
    echo "The fix is working - location-specific limit (1G) was used"  
else  
    echo ""  
    echo "❌ FAILED: Server did not return 200 OK"  
    echo "Check test_output.log for details"  
fi  
  
# Cleanup  
kill $SERVER_PID 2>/dev/null
