# Global settings (Optional, but good for root or max_body)
http {
    # Default error pages for the whole server
    error_page 404 /errors/404.html;
    client_max_body_size 10M;

    server {
        listen 8080;
        server_name localhost;
        root /var/www/html;
        index index.html;

        # Route for static files
        location / {
            allow_methods GET;
            autoindex on;
        }

        # Route for uploads
        location /uploads {
            allow_methods POST GET DELETE;
            root /var/www/uploads;
            upload_store /tmp/webserv_uploads;
        }

        # Route for CGI
        location /cgi-bin {
            allow_methods GET POST;
            cgi_pass .py /usr/bin/python3;
            cgi_pass .php /usr/bin/php-cgi;
        }
    }

    server {
        listen 9090;
        server_name myserver.com;
        
        location / {
            return 301 https://localhost:8080;
        }
    }
}