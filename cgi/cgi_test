#!/usr/bin/env python3
import sys
import os

# Read all data from standard input (which your server pipes from the file_fd)
body_data = sys.stdin.read()
actual_bytes_received = len(body_data)

# Print valid HTTP CGI response headers
print("Status: 200 OK")
print("Content-Type: text/plain")
print("")  # Mandatory CRLF separator

# Print the confirmation report
print(f"--- CGI Execution Success ---")
print(f"Requested Content-Length: {os.environ.get('CONTENT_LENGTH', 'NOT SET')}")
print(f"Actual Bytes Read via Stdin: {actual_bytes_received}")

if actual_bytes_received == 20000000:
    print("SUCCESS: 100% of the payload streamed through the file-backed layer flawlessly.")
else:
    print("WARNING: Data mismatch or dropped bytes detected!")
